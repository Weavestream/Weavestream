# ─────────────────────────────────────────────────────────────────────────
# Weavestream — environment template
#
# 1. Copy this file to .env next to compose.yml.
# 2. Generate fresh secrets (values starting with REPLACEME below must
#    all be overwritten):
#
#      macOS / Linux / WSL:   ./scripts/keygen.sh >> .env
#      Windows PowerShell:    .\scripts\keygen.ps1 | Out-File -Append -Encoding ascii .env
#
#    Then delete the REPLACEME rows from the top of your .env.
# 3. docker compose up -d
#
# Pin a specific release by setting WEAVESTREAM_VERSION (e.g. 1.0.0).
# Leave unset to track :latest — recommended only for dev.
# ─────────────────────────────────────────────────────────────────────────

# Release pinning — match a tag published at
# https://github.com/Weavestream/Weavestream/pkgs/container/weavestream-api
WEAVESTREAM_VERSION=latest

# Host port mappings (exposed only by compose.yml; adjust if the
# defaults collide with other stacks on your workstation).
WEB_HOST_PORT=3000
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ─── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=weavestream
POSTGRES_PASSWORD=REPLACEME
POSTGRES_DB=weavestream
DATABASE_URL=postgresql://weavestream:REPLACEME@postgres:5432/weavestream

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACEME
REDIS_URL=redis://:REPLACEME@redis:6379/0

# ─── Auth ────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=REPLACEME_32_BYTES_BASE64
JWT_SIGNING_KEY_KID=2026-01
JWT_PREVIOUS_KEYS=
SESSION_COOKIE_NAME=ws_session
SESSION_MAX_AGE_DAYS=30
ACCESS_TOKEN_TTL_MIN=15
MFA_ENCRYPTION_KEY=REPLACEME_32_BYTES_BASE64
COOKIE_SIGNING_KEY=REPLACEME_32_BYTES_BASE64
CSRF_SIGNING_KEY=REPLACEME_32_BYTES_BASE64
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# ─── Rate limiting ───────────────────────────────────────────────────────
GLOBAL_RATE_LIMIT_PER_MIN=100
AUTH_RATE_LIMIT_PER_MIN=5
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_MIN=15

# ─── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Object storage (MinIO / S3-compatible) ──────────────────────────────
# MINIO_ENDPOINT is the *internal* hostname the API connects to;
# MINIO_PUBLIC_URL is the origin browsers hit for presigned PUT/GET.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=REPLACEME
MINIO_SECRET_KEY=REPLACEME
MINIO_BUCKET_PREFIX=weavestream
MINIO_PUBLIC_URL=http://localhost:9100
# Browsers fetch thumbnails and presigned downloads directly from MinIO,
# so the web app's CSP must allow those origins. Defaults to
# MINIO_PUBLIC_URL; comma-separated list if you front MinIO behind
# multiple CDN/edge hostnames.
NEXT_PUBLIC_MINIO_ORIGINS=http://localhost:9100

# ─── Upload policy ───────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
# Client-side pre-flight mirror of MAX_UPLOAD_MB. Keep in sync; the
# server is still the source of truth and will reject oversize uploads.
NEXT_PUBLIC_MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,image/gif,image/heic,application/pdf,text/plain,text/markdown,text/x-markdown,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,application/x-zip-compressed,application/x-7z-compressed,application/x-tar,application/gzip,application/x-msi,application/x-ms-installer,application/vnd.ms-outlook,text/x-shellscript,text/x-python,application/json,application/xml,text/xml,text/yaml,application/x-yaml
