# ─────────────────────────────────────────────────────────────────────────
# Weavestream — environment template
#
#   1. Copy this file to .env next to compose.yml.
#   2. Generate secrets and append them:
#        macOS / Linux / WSL:  ./scripts/keygen.sh >> .env
#        Windows PowerShell:   .\scripts\keygen.ps1 | Out-File -Append -Encoding ascii .env
#      keygen fills POSTGRES_PASSWORD, REDIS_PASSWORD, and every *_KEY below.
#      Delete the REPLACEME rows it replaced, and paste the generated
#      passwords into DATABASE_URL / REDIS_URL.
#   3. docker compose up -d
#
# This template covers the required settings plus a few commonly-tuned knobs.
# Every other option has a safe default — full reference at
# https://docs.weavestream.io/configuration/environment/
# ─────────────────────────────────────────────────────────────────────────

# ─── 1. Deployment ───────────────────────────────────────────────────────
# Image tag to run. Pin to a published release (e.g. 1.0.0) in production;
# `latest` is for dev only.
WEAVESTREAM_VERSION=latest

# Host port for the web UI — the only port compose.yml publishes, bound on
# all interfaces. Front internet-facing installs with a TLS reverse proxy
# (Caddy/Nginx/Traefik): https://docs.weavestream.io/deployment/tls/
WEB_HOST_PORT=3000

# Host path for persistent data; creates $DATA_DIR/{postgres,redis,files}.
# Use an absolute path to store data outside the deploy dir, e.g.
# /volume1/docker/weavestream (Synology) or /srv/weavestream (Linux).
DATA_DIR=./data

# ─── 2. Core ─────────────────────────────────────────────────────────────
# Keep NODE_ENV=production for any real deployment — development mode relaxes
# the CSP and skips hardening. APP_URL / API_URL are your public origins.
NODE_ENV=production
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ─── 3. Database ─────────────────────────────────────────────────────────
# POSTGRES_PASSWORD must match the password embedded in DATABASE_URL.
POSTGRES_USER=weavestream
POSTGRES_PASSWORD=REPLACEME
POSTGRES_DB=weavestream
DATABASE_URL=postgresql://weavestream:REPLACEME@postgres:5432/weavestream

# ─── 4. Redis ────────────────────────────────────────────────────────────
# REDIS_PASSWORD must match the password embedded in REDIS_URL.
REDIS_PASSWORD=REPLACEME
REDIS_URL=redis://:REPLACEME@redis:6379/0

# ─── 5. Secrets ──────────────────────────────────────────────────────────
# 32-byte base64 keys generated by scripts/keygen.sh. Losing a key after
# data is written under it is unrecoverable — back these up. (The matching
# key-id labels default to "1"; you only set a *_KID when rotating a key.)
# Key rotation: https://docs.weavestream.io/configuration/key-rotation/
JWT_SIGNING_KEY=REPLACEME_32_BYTES_BASE64
MFA_ENCRYPTION_KEY=REPLACEME_32_BYTES_BASE64
PASSWORD_ENCRYPTION_KEY=REPLACEME_32_BYTES_BASE64
INTEGRATION_SECRET_KEY=REPLACEME_32_BYTES_BASE64
SMTP_SECRET_KEY=REPLACEME_32_BYTES_BASE64
COOKIE_SIGNING_KEY=REPLACEME_32_BYTES_BASE64
CSRF_SIGNING_KEY=REPLACEME_32_BYTES_BASE64

# ─── 6. Reverse proxy ────────────────────────────────────────────────────
# Trusted proxy hops in front of the `web` container, used to resolve the
# real client IP for rate limiting, lockout, and audit logs.
#   1 = one reverse proxy (default)   2 = CDN → proxy   0 = web exposed directly
# Too high lets an upstream forge client IPs; too low collapses everyone into
# one bucket. Details: https://docs.weavestream.io/deployment/tls/
TRUST_PROXY_HOPS=1

# ─── 7. Optional tuning ──────────────────────────────────────────────────
# Everything below has a safe default and can stay commented out — uncomment
# a line to override. This is only the common subset; the full list (Argon2,
# integrations, egress/SSRF guard, backups, schedulers, …) lives at
# https://docs.weavestream.io/configuration/environment/
#
# GLOBAL_RATE_LIMIT_PER_MIN=600    # requests/min per user (client IP for anon)
# AUTH_RATE_LIMIT_PER_MIN=5        # login attempts/min per IP + email
# LOCKOUT_MAX_FAILURES=5           # failed logins before soft-lock
# LOCKOUT_WINDOW_MIN=15            # soft-lock duration (minutes)
# SESSION_MAX_AGE_DAYS=30          # session cookie lifetime (days)
# ACCESS_TOKEN_TTL_MIN=15          # access token lifetime (minutes)
# LOG_LEVEL=info                   # trace | debug | info | warn | error | fatal
# MAX_UPLOAD_MB=25                 # server-enforced upload size cap (MB)
# NEXT_PUBLIC_MAX_UPLOAD_MB=25     # client-side mirror; keep in sync
# HIBP_ENABLED=true                # HaveIBeenPwned breach check on passwords
