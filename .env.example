# ─────────────────────────────────────────────────────────────────────────
# Weavestream — environment template
#
# 1. Copy this file to .env next to compose.yml.
# 2. Generate fresh secrets (values starting with REPLACEME below must
#    all be overwritten):
#
#      macOS / Linux / WSL:   ./scripts/keygen.sh >> .env
#      Windows PowerShell:    .\scripts\keygen.ps1 | Out-File -Append -Encoding ascii .env
#
#    Then delete the REPLACEME rows from the top of your .env.
# 3. docker compose up -d
#
# Pin a specific release by setting WEAVESTREAM_VERSION (e.g. 1.0.0).
# Leave unset to track :latest — recommended only for dev.
# ─────────────────────────────────────────────────────────────────────────

# Release pinning — match a tag published at
# https://github.com/Weavestream/Weavestream/pkgs/container/weavestream-api
WEAVESTREAM_VERSION=latest

# Host port mappings exposed by compose.yml. The default install only
# publishes WEB_HOST_PORT (the Next.js UI), and compose binds it on all
# host interfaces (0.0.0.0).
#
# Direct exposure of WEB_HOST_PORT is for LOCAL / LAN use only. Any
# internet-facing deployment MUST front `web` with a trusted TLS reverse
# proxy (Caddy/Nginx/Traefik) and keep TRUST_PROXY_HOPS=1 — otherwise a
# client can forge X-Forwarded-For and poison audit IPs, per-IP lockout /
# rate-limit buckets, and IP allow/deny rules. See docs/deployment/tls.
# (If your proxy runs on the same host, bind this port to loopback — see
# the commented `127.0.0.1:...` mapping in compose.yml.)
#
# Postgres and Redis stay on the internal docker network; for ad-hoc
# inspection use `docker compose exec postgres psql ...` /
# `docker compose exec redis redis-cli ...`, or layer compose.build.yml
# (contributor builds) which re-publishes 5434 / 6381 on the host.
WEB_HOST_PORT=3000

# Where persistent data lives on the HOST filesystem. Creates
# $DATA_DIR/{postgres,redis,files} the first time you `up`. Defaults
# to ./data relative to compose.yml — swap for an absolute path if
# you want the data outside the deploy directory, e.g.
#   DATA_DIR=/volume1/docker/weavestream        (Synology / UGREEN)
#   DATA_DIR=/srv/weavestream                   (plain Linux)
#   DATA_DIR=C:\docker\weavestream              (Windows, use forward slashes in compose)
DATA_DIR=./data

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ─── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=weavestream
POSTGRES_PASSWORD=REPLACEME
POSTGRES_DB=weavestream
DATABASE_URL=postgresql://weavestream:REPLACEME@postgres:5432/weavestream

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACEME
REDIS_URL=redis://:REPLACEME@redis:6379/0

# ─── Auth ────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=REPLACEME_32_BYTES_BASE64
JWT_SIGNING_KEY_KID=2026-01
JWT_PREVIOUS_KEYS=
SESSION_COOKIE_NAME=ws_session
SESSION_MAX_AGE_DAYS=30
ACCESS_TOKEN_TTL_MIN=15
MFA_ENCRYPTION_KEY=REPLACEME_32_BYTES_BASE64
COOKIE_SIGNING_KEY=REPLACEME_32_BYTES_BASE64
CSRF_SIGNING_KEY=REPLACEME_32_BYTES_BASE64
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# ─── Password vault ──────────────────────────────────────────────────────
# Encrypts every password/TOTP secret/notes blob in the password manager.
# To rotate: generate a fresh key, set it as PASSWORD_ENCRYPTION_KEY +
# bump _KID (e.g. 2026-02), and move the old pair into PASSWORD_PREVIOUS_KEYS
# as `kid:base64key` (comma-separated for multiple). Rows written under
# a previous kid decrypt seamlessly and are re-encrypted under the current
# kid on their next update; run `pnpm --filter @weavestream/api cli reencrypt-passwords`
# to rewrite everything eagerly.
PASSWORD_ENCRYPTION_KEY=REPLACEME_32_BYTES_BASE64
PASSWORD_ENCRYPTION_KEY_KID=2026-01
PASSWORD_PREVIOUS_KEYS=
# HaveIBeenPwned breach check on create/update. Uses k-anonymity — only
# the first 5 hex chars of the SHA-1 leave the server. Set to false to
# disable the outbound request entirely.
HIBP_ENABLED=true

# ─── Integration framework ────────────────────────────────────
# Encrypts the credential bundle on every Integration row (Action1 API
# token, etc.). Same `kid`-tagged AES-256-GCM scheme as the password vault.
# Rotate by generating a fresh 32-byte key, bumping _KID, and moving the
# old pair into INTEGRATION_PREVIOUS_KEYS (`kid:base64key`, comma-separated).
INTEGRATION_SECRET_KEY=REPLACEME_32_BYTES_BASE64
INTEGRATION_SECRET_KEY_KID=2026-01
INTEGRATION_PREVIOUS_KEYS=

# BullMQ scheduler — fires the orchestrator on every ACTIVE Integration
# whose row sets `syncCron = null`. Set to "off" to disable scheduled
# syncs globally; manual runs from /admin/integrations still work.
INTEGRATION_SYNC_DEFAULT_CRON=0 */4 * * *

# Concurrency caps for the orchestrator (parent fan-out) and per-mapping
# (child fetch + upsert) workers. Tune up if Action1 / future drivers
# tolerate higher throughput.
INTEGRATION_SYNC_ORCHESTRATOR_CONCURRENCY=2
INTEGRATION_SYNC_MAPPING_CONCURRENCY=5

# Outbound HTTP defaults for every driver. Drivers may override per-call.
INTEGRATION_HTTP_TIMEOUT_MS=30000
INTEGRATION_HTTP_MAX_RETRIES=5
INTEGRATION_HTTP_BACKOFF_MS=1000

# ─── SMTP email ──────────────────────────────────────────────────────────
# Encrypts the saved SMTP password configured under Admin → Settings → Email.
# Rotate the same way as integration secrets: generate a fresh key, bump _KID,
# and move the old pair into SMTP_PREVIOUS_KEYS (`kid:base64key`).
SMTP_SECRET_KEY=REPLACEME_32_BYTES_BASE64
SMTP_SECRET_KEY_KID=2026-01
SMTP_PREVIOUS_KEYS=

# ─── Rate limiting ───────────────────────────────────────────────────────
# Requests/minute per identity. A request's identity is the authenticated
# user id when available, falling back to the real client IP (the API
# trusts X-Forwarded-For from the web tier). Each operator gets their
# own bucket — the previous default of 100 assumed a raw-IP tracker and
# collapsed every SSR render in Docker into a single bucket, manifesting
# as 429-as-404 flakes. 600 gives a generous ceiling per user while
# still catching runaway scripts.
GLOBAL_RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=5
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_MIN=15

# Step-up (re-authentication) validity window, in seconds. After an admin
# re-confirms a credential (MFA code or password) on a highly sensitive
# action — backup dump download, vault export with passwords, role /
# capability changes, MFA reset, session revoke, AI/SMTP/integration
# secret changes — that confirmation is cached (bound to the session) for
# this long before another is required. Range 60–3600; default 900 (15m).
STEP_UP_TTL_SEC=900

# Number of trusted reverse-proxy hops between the internet and the
# `web` container — i.e. the edge tier you run in front of compose.
# The web tier reads this to resolve the real client IP from the
# inbound `X-Forwarded-For` chain and then forwards a single sanitized
# entry to the API. The API itself doesn't read it: it honors XFF only
# when the TCP peer is on the private docker bridge.
#
# Pick the value that matches your edge in front of `web`:
#   1 → trusted reverse proxy (Caddy/Nginx/Traefik) → web → api
#       (default; the recommended production shape — your edge MUST
#       overwrite or append to X-Forwarded-For)
#   2 → CDN (Cloudflare, …) → edge proxy → web → api
#   0 → web is directly internet-facing (no edge proxy)
#
# Setting too high lets a malicious upstream forge the client IP.
# Setting too low collapses every request behind your edge into one
# throttler bucket.
#
# `TRUST_PROXY_HOPS=0` is the only safe value when `web` is exposed
# directly to the internet — it forces every request to be attributed
# to the `0.0.0.0` sentinel so a client can't spoof their apparent IP.
# The trade-off: per-IP login lockout, anonymous rate limit, IP
# allow/deny rules, and audit attribution all collapse into a single
# bucket, which makes anonymous lockout a denial-of-service amplifier.
# If IP-based controls matter to you, run a trusted reverse proxy in
# front of `web` and keep `TRUST_PROXY_HOPS=1`.
TRUST_PROXY_HOPS=1

# Dev-only: comma-separated origins (host or host:port) allowed to fetch
# Next.js dev resources (HMR, /_next/static, etc.) when accessing the dev
# server from a non-localhost origin (e.g. testing the UI on a phone over
# the LAN). Without this, Next 16 hard-blocks dev resources and the React
# bundle never finishes hydrating, which silently breaks form submission.
# Production builds ignore this setting.
#   WEB_ALLOWED_DEV_ORIGINS=192.168.1.88
#   WEB_ALLOWED_DEV_ORIGINS=192.168.1.88,my-laptop.local
WEB_ALLOWED_DEV_ORIGINS=

# ─── Egress / SSRF guard ─────────────────────────────────────────────────
# Every server-side outbound HTTP call (integration drivers, RDAP/HIBP
# probes, domain availability checks) flows through `safeFetch`, which
# refuses to dial loopback / RFC1918 / link-local / cloud-metadata
# (169.254.169.254) targets. Each refusal lands in the audit log as
# `security.egress.blocked` and surfaces in Admin → Security → "Egress
# blocks".
#
# EGRESS_ALLOW_PRIVATE_NETWORKS=true short-circuits the whole guard.
# Use only on lab / single-host installs where the API legitimately
# talks to sibling containers over a flat private network.
#
# EGRESS_ALLOWED_PRIVATE_CIDRS is the surgical alternative — a comma-
# separated list of CIDRs that are allowed even when the global block
# is on. Useful for on-prem RMM endpoints, e.g.
#   EGRESS_ALLOWED_PRIVATE_CIDRS=10.42.0.0/16,192.168.50.0/24
EGRESS_ALLOW_PRIVATE_NETWORKS=false
EGRESS_ALLOWED_PRIVATE_CIDRS=

# ─── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── File storage ────────────────────────────────────────────────────────
# Every uploaded file (attachments, thumbnails, company logos, export
# PDFs) lives in a per-tenant directory under the data folder you
# configured above (default `./data/files`, alongside `./data/postgres`
# and `./data/redis`):
#   ${DATA_DIR}/files/<companyId>/uploads/<uploadId>/<filename>
#   ${DATA_DIR}/files/<companyId>/thumbs/<uploadId>.webp
#   ${DATA_DIR}/files/<companyId>/exports/<exportId>.pdf
# Browsers never read the directory directly — every read streams
# through the API on the same origin as the web app, so a single
# reverse-proxy entry covers Weavestream end-to-end.
#
# Leave this unset on the standard Docker install. compose.yml bind-
# mounts ${DATA_DIR}/files into the api+worker containers and points
# FILE_STORAGE_DIR at the mount path automatically. Override only if
# you want files to live somewhere completely outside ${DATA_DIR}.
# FILE_STORAGE_DIR=/srv/weavestream-files

# Scheduled Postgres exports (admin Backups page) land here. Same
# guidance as FILE_STORAGE_DIR: leave unset on the standard Docker
# install — compose.yml bind-mounts ${DATA_DIR}/backup and points
# BACKUP_STORAGE_DIR at the mount path. Override only if you need
# the dumps somewhere outside ${DATA_DIR}.
# BACKUP_STORAGE_DIR=/srv/weavestream-backup

# Maximum minutes a single backup job is allowed to run before BullMQ
# treats its worker lock as stalled. Default 360 (6 h) covers everything
# from the typical sub-GB Weavestream Postgres up to tens-of-GB audit-
# heavy installs on consumer NAS hardware. Raise for unusually large
# databases on slow disks; lower if you want quicker stall detection
# on SSD-backed installs. Range: 5..1440.
# BACKUP_JOB_LOCK_MINUTES=360

# ─── Upload policy ───────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
# Client-side pre-flight mirror of MAX_UPLOAD_MB. Keep in sync; the
# server is still the source of truth and will reject oversize uploads.
NEXT_PUBLIC_MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,image/gif,image/heic,application/pdf,text/plain,text/markdown,text/x-markdown,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,application/x-zip-compressed,application/x-7z-compressed,application/x-tar,application/gzip,application/x-msi,application/x-ms-installer,application/vnd.ms-outlook,message/rfc822,text/x-shellscript,text/x-python,application/json,application/xml,text/xml,text/yaml,application/x-yaml
