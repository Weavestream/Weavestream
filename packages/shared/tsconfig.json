{
  "extends": "../config/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    // Colocated with the output it describes. The default location is
    // next to this config file, which means `rm -rf dist` leaves the
    // incremental state behind — tsc then reports "up to date", emits
    // NOTHING, and exits 0. Consumers fail much later with an
    // unresolvable `@weavestream/shared`, which is a confusing way to
    // learn that a clean step half-worked. Sharing a directory makes
    // deleting the output invalidate the state that describes it.
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  // `src/browser/**` is compiled by tsconfig.browser.json instead, which is
  // the only project with the DOM libs. Leaving it in here would fail the
  // build on `document` / `navigator` / `ClipboardItem`.
  "exclude": ["src/**/*.spec.ts", "src/browser/**"]
}
