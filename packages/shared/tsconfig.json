{
  "extends": "../config/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true
  },
  "include": ["src/**/*.ts"],
  // `src/browser/**` is compiled by tsconfig.browser.json instead, which is
  // the only project with the DOM libs. Leaving it in here would fail the
  // build on `document` / `navigator` / `ClipboardItem`.
  "exclude": ["src/**/*.spec.ts", "src/browser/**"]
}
