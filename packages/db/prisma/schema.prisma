// Weavestream — schema.
// Phase 1 auth models + Phase 2 RBAC/invite additions + Phase 3 asset layout
// and asset data plane + Phase 4 documentation plane (Article, Folder,
// Upload) + Phase 5 SystemSetting singleton (workspace branding + tenant
// term) + Phase 6 SearchIndex (full-text search) + Phase 8 MonitoredDomain
// / DomainCheck (domain & SSL monitor).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OPERATOR
  CONTRACTOR
  CLIENT_USER
}

// Per-company access level. FULL grants CRUD on company-scoped data,
// READONLY grants read-only access. Used for both `Membership.role`
// (the per-tenant override) and `User.globalAccess` (the OPERATOR
// default for companies they don't have a membership for, where
// `NONE` means "no access by default — only explicit memberships").
enum MembershipRole {
  FULL
  READONLY
}

enum GlobalAccess {
  FULL
  READONLY
  NONE
}

// Granular platform-admin capabilities that previously required
// SUPER_ADMIN. SUPER_ADMIN implicitly holds every capability;
// OPERATORs can be granted any subset; CONTRACTOR/CLIENT_USER must
// have an empty array (enforced by the service layer). Promoting or
// demoting another user to/from SUPER_ADMIN is reserved for
// SUPER_ADMINs regardless of `USER_MANAGE`.
enum PlatformCapability {
  COMPANY_MANAGE
  INTEGRATION_MANAGE
  LAYOUT_MANAGE
  TAG_MANAGE
  USER_MANAGE
  MEMBERSHIP_MANAGE
  AUDIT_READ
  SETTINGS_MANAGE
  EXPORT_CREATE
  ALERT_MANAGE
  SECURITY_READ
  // Phase 5: IP allow/deny rule management
  IP_RULE_MANAGE
  // Scheduled Postgres exports (backup feature). Delegatable to a
  // senior operator; intentionally NOT part of MANAGER_PRESET because
  // holders of this capability can read and download full DB dumps.
  BACKUP_MANAGE
  // Phase 12+: read-only global ticket browse across every client
  // visible to the operator. Holders can view ticket subjects,
  // bodies, and activity timelines from the integrated upstream
  // helpdesk. Read-only; no writes back to upstream. Part of
  // MANAGER_PRESET.
  TICKETS_READ
}

// Phase 3: every AssetField has exactly one FieldType. The type is immutable
// after creation because changing it would invalidate the JSONB shape of
// every stored AssetFieldValue — the builder UI shows "Remove + add new"
// as the only path to reshape a field. `RICH_TEXT` and `FILE` are
// first-class in the enum but their editors are stubbed in Phase 3 and
// fully implemented in Phase 4.
// Phase 8 domain monitor. Aggregated per-sub-check result:
//   OK   – check succeeded, no action needed
//   WARN – soft warning (e.g. cert valid but chain shorter than
//          expected, or close to expiry but not yet within threshold)
//   FAIL – check failed (network error, invalid cert, missing records)
//   SKIP – the operator disabled this sub-check on the domain
enum CheckResult {
  OK
  WARN
  FAIL
  SKIP
}

// Phase 8: denormalised latest status. Listed here so the list view
// doesn't need to join DomainCheck for every row — the processor
// writes both the child DomainCheck row and the parent's
// `latestStatus` in the same transaction.
enum DomainStatus {
  OK
  EXPIRING
  EXPIRED
  FAIL
  UNKNOWN
}

// Phase 9a: coarse classification for a Company row. Kept as a fixed enum
// (rather than a free-form string or a lookup table) so the list/table
// renderers can style each type consistently without another round-trip
// to the DB. New values are cheap to add later via a follow-up migration
// if operators request more granularity.
// Per-company "sticky note" banner shown above the breadcrumbs on every
// admin page for that company. Severity drives banner colour (and, for
// CRITICAL, sticky positioning so it stays in view while scrolling).
enum StickyNoteSeverity {
  INFO
  WARN
  CRITICAL
}

enum CompanyType {
  CLIENT
  PROSPECT
  VENDOR
  INTERNAL
  PARTNER
  OTHER
}

// Phase 9b.1: per-user UI preferences. `SYSTEM` defers to the browser's
// `prefers-color-scheme` media query at paint time (via a nonced inline
// script in the root layout) so returning users never see a wrong-theme
// flash before hydration.
enum UiTheme {
  DARK
  LIGHT
  SYSTEM
}

// Phase 9b.1: accent palette. Mirrors the five [data-accent="…"] swatches
// in apps/web/src/styles/tokens.css. Keep this enum in lock-step with that
// file — adding an accent requires both a CSS block and a migration.
enum UiAccent {
  LIME
  AMBER
  IRIS
  CORAL
  TEAL
}

enum FieldType {
  TEXT
  TEXTAREA
  RICH_TEXT
  NUMBER
  DATE
  DATETIME
  BOOLEAN
  DROPDOWN
  MULTISELECT
  EMAIL
  PHONE
  URL
  ASSET_REFERENCE
  VAULTWARDEN_LINK
  FILE
  TAGS
  IP_ADDRESS
}

// Phase 10: password vault. TOTP algorithm options match RFC 6238 +
// otplib — SHA1 is the default for broad authenticator-app compatibility.
enum TotpAlgo {
  SHA1
  SHA256
  SHA512
}

enum SmtpSecurityMode {
  STARTTLS
  TLS
  NONE
}

model User {
  id                        String               @id @default(uuid()) @db.Uuid
  email                     String               @unique
  name                      String
  passwordHash              String?              @map("password_hash")
  role                      UserRole             @default(OPERATOR)
  // Two-axis OPERATOR model. `globalAccess` governs company-scoped
  // CRUD on companies the operator doesn't have an explicit membership
  // for; memberships always override it per-company. Required for
  // OPERATOR users (FULL/READONLY/NONE), null for everyone else
  // (enforced in the service layer).
  globalAccess              GlobalAccess?        @map("global_access")
  // Granular platform-admin capabilities. Empty for non-OPERATORs.
  // SUPER_ADMIN implicitly holds every capability — this column is
  // ignored for them and kept empty.
  platformCapabilities      PlatformCapability[] @default([]) @map("platform_capabilities")
  isActive                  Boolean              @default(true) @map("is_active")
  mfaEnabled                Boolean              @default(false) @map("mfa_enabled")
  mfaSecretEncrypted        String?              @map("mfa_secret_encrypted")
  mfaEnforcementCompletedAt DateTime?            @map("mfa_enforcement_completed_at")
  deactivatedAt             DateTime?            @map("deactivated_at")
  timezone                  String?
  // Phase 6: per-user defaults for the command palette. Shape:
  // { defaultComprehensive: boolean, defaultGlobal: boolean }.
  // NULL = both toggles off. Validated by userSearchDefaultsSchema.
  searchDefaults            Json?                @map("search_defaults")
  // Phase 9b.1: appearance preferences. Server-persisted so the choice
  // follows a user across devices. The auth layer mirrors both values
  // into the non-HttpOnly `ws_ui` cookie so the root layout can paint
  // the correct theme on the very first byte without calling /auth/me.
  uiTheme                   UiTheme              @default(SYSTEM) @map("ui_theme")
  uiAccent                  UiAccent             @default(LIME) @map("ui_accent")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  lastLoginAt               DateTime?            @map("last_login_at")

  memberships       Membership[]
  sessions          Session[]
  mfaBackupCodes    UserMfaBackupCode[]
  auditLogs         AuditLog[]          @relation("AuditActor")
  setupTokens       UserSetupToken[]    @relation("SetupTokenOwner")
  issuedSetupTokens UserSetupToken[]    @relation("SetupTokenCreator")
  starredCompanies  StarredCompany[]
  starredPasswords  StarredPassword[]
  starredAssets     StarredAsset[]
  starredArticles   StarredArticle[]
  chatConversations ChatConversation[]

  @@map("users")
}

model Company {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  isActive   Boolean   @default(true) @map("is_active")
  notes      String?
  archivedAt DateTime? @map("archived_at")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Phase 9a: expanded info. Every new column is optional (except `type`
  // which defaults to CLIENT) so existing rows need no backfill.
  type            CompanyType @default(CLIENT)
  quickNotes      String?     @map("quick_notes")
  // Self-FK for parent organisations. Cycle prevention lives in the
  // service layer (`ensureNoParentCycle`) — Postgres has no native
  // support for cyclic-check constraints on a graph like this.
  parentCompanyId String?     @map("parent_company_id") @db.Uuid
  parent          Company?    @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  children        Company[]   @relation("CompanyHierarchy")

  // Primary contact — a lightweight inline snapshot rather than a full
  // Contacts table. Phase 9a scope is explicitly one contact per
  // company; promote to a real model if operators later ask for more.
  contactName  String? @map("contact_name")
  contactTitle String? @map("contact_title")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  generalEmail String? @map("general_email")
  phone        String?
  fax          String?
  website      String?

  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  region       String?
  postalCode   String? @map("postal_code")
  country      String?

  // Reuses the existing `Upload` system — one company owns at most one
  // logo, one upload backs at most one company.
  logoUploadId String? @unique @map("logo_upload_id") @db.Uuid
  logoUpload   Upload? @relation("CompanyLogo", fields: [logoUploadId], references: [id], onDelete: SetNull)

  // Per-company sticky note. Both columns nullable; the API enforces
  // that severity is only set when text is also set (clearing text
  // clears severity). When text is null, no banner renders.
  stickyNoteText     String?             @map("sticky_note_text")
  stickyNoteSeverity StickyNoteSeverity? @map("sticky_note_severity")

  memberships         Membership[]
  starredBy           StarredCompany[]
  passwords           Password[]
  passwordFolders     PasswordFolder[]
  // Phase 11: per-tenant org-to-company mappings owned by a global
  // integration (Action1 organisation → Weavestream company).
  // Cascade delete clears mappings if a company is hard-deleted, but
  // we never archive assets in that path — see `IntegrationCompanyMapping`.
  integrationMappings IntegrationCompanyMapping[]
  integrationSyncCheckpoints         IntegrationSyncCheckpoint[]
  integrationReconstructionSummaries IntegrationReconstructionSummary[]
  integrationReconstructionGaps      IntegrationReconstructionGap[]

  @@index([type])
  @@index([parentCompanyId])
  @@map("companies")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  role      MembershipRole
  expiresAt DateTime?      @map("expires_at")
  createdBy String?        @map("created_by") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  revokedAt DateTime?      @map("revoked_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Active uniqueness is enforced by a partial unique index on
  // (user_id, company_id) WHERE revoked_at IS NULL, added in the
  // phase2_companies_users_memberships migration. Historical revoked
  // rows are allowed so revocation never blocks re-adding a user.
  @@index([userId])
  @@index([companyId])
  @@map("memberships")
}

// Phase 9b.3: per-user "starred" companies — pins a company to the
// operator dashboard's Starred panel. Separate from Membership so a
// SUPER_ADMIN can star a company without also taking a per-company
// role (useful when monitoring an account without being on the hook
// to edit it). Cascade-on-delete so removing either side cleans up.
model StarredCompany {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId, createdAt])
  @@map("starred_companies")
}

model StarredPassword {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  passwordId String   @map("password_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  password Password @relation(fields: [passwordId], references: [id], onDelete: Cascade)

  @@unique([userId, passwordId])
  @@index([userId, createdAt])
  @@map("starred_passwords")
}

model StarredAsset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
  @@index([userId, createdAt])
  @@map("starred_assets")
}

model StarredArticle {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
  @@map("starred_articles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  // Single-generation refresh-token rotation: the hash of the
  // immediately-prior refresh token (null until first rotation) and when
  // that rotation happened. Re-presenting the previous token within a
  // short grace window is a benign concurrent refresh; later it is reuse.
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  rotatedAt                DateTime? @map("rotated_at")
  mfaPending       Boolean   @default(false) @map("mfa_pending")
  ip               String
  userAgent        String    @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model UserMfaBackupCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, consumedAt])
  @@map("user_mfa_backup_codes")
}

model UserSetupToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  user    User  @relation("SetupTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  creator User? @relation("SetupTokenCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_setup_tokens")
}

/// Append-only audit trail. A `BEFORE UPDATE OR DELETE` trigger
/// installed in migration `0032_audit_log_immutable` rejects any
/// UPDATE/DELETE against `audit_log` with `audit_log is append-only`.
/// Backup/restore tooling that needs to rewrite rows must temporarily
/// disable the trigger as the table owner — see docs/INSTALL.md.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  companyId  String?  @map("company_id") @db.Uuid
  ip         String?
  userAgent  String?  @map("user_agent")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// Phase 3: AssetLayout is *global* — every company uses the exact same
// catalog. There is deliberately no `companyId` column (see DECISIONS.md
// D-007 layouts-are-global). Only SUPER_ADMIN can mutate layouts; every
// other role has read access via `GET /layouts` so they can render forms
// and lists.
model AssetLayout {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String
  icon       String
  color      String
  isActive   Boolean   @default(true) @map("is_active")
  // Operator-curated ordering. Drives the company-scoped sidebar's
  // Layouts section so related categories can be grouped together
  // (e.g. Workstations / Servers / Network gear). Tie-breaks
  // alphabetically on `name`.
  position   Int       @default(0)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  fields               AssetField[]
  assets               Asset[]
  // Phase 11.1: integration resources target a layout for upserts.
  // Each `(integration, resourceKey)` row picks its own layout, so a
  // single integration (e.g. UniFi) can fan out to two distinct
  // layouts (devices vs clients) via two `IntegrationResource` rows.
  integrationResources IntegrationResource[]

  // Active-slug uniqueness enforced by a partial unique index on
  // (slug) WHERE archived_at IS NULL, added in the Phase 3 migration.
  @@index([isActive, archivedAt, position])
  @@map("asset_layouts")
}

// Phase 3: fields of an AssetLayout. `options` is a JSONB blob whose shape
// depends on `fieldType` — validated at write time by FieldTypeStrategy
// registry on the API. For DATE/DATETIME, `options.isExpiry` drives the
// warranty-countdown chip in the mock's AssetDetail header and the
// colour-coded warranty cell in AssetList.
model AssetField {
  id                 String    @id @default(uuid()) @db.Uuid
  assetLayoutId      String    @map("asset_layout_id") @db.Uuid
  name               String
  slug               String
  fieldType          FieldType @map("field_type")
  position           Int
  isRequired         Boolean   @default(false) @map("is_required")
  isUniquePerCompany Boolean   @default(false) @map("is_unique_per_company")
  visibleToClients   Boolean   @default(true) @map("visible_to_clients")
  isPrimary          Boolean   @default(false) @map("is_primary")
  // When true, the field is rendered as a column in the per-layout
  // asset table view. The primary field is always shown regardless —
  // the table renderer treats `isPrimary || showInTable` as the
  // column-inclusion predicate, so this flag is effectively a no-op
  // on the primary and the builder UI locks the toggle there.
  // RICH_TEXT and FILE are rejected at the API layer because their
  // cell representations are unreadable in a table.
  showInTable        Boolean   @default(false) @map("show_in_table")
  options            Json      @default("{}")
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  assetLayout              AssetLayout               @relation(fields: [assetLayoutId], references: [id], onDelete: Cascade)
  values                   AssetFieldValue[]
  // Phase 11: integrations may project a remote source field onto this
  // AssetField (one row per (companyMapping, sourceField)).
  integrationFieldMappings IntegrationFieldMapping[]

  // (assetLayoutId, slug) WHERE archived_at IS NULL and "at most one primary
  // per layout" are both enforced by partial unique indexes in the migration.
  @@index([assetLayoutId, position])
  @@map("asset_fields")
}

// Tag is *global* — same identity model as AssetLayout/AssetField. There is
// deliberately no `companyId`: a tag created in one company is reusable
// across every company and every layout. Any authenticated user can create
// a tag inline while editing an asset (the asset-write tx upserts unknown
// names → ids); rename/delete is gated by `tag.manage.global`
// (TAG_MANAGE / SUPER_ADMIN). Case-insensitive uniqueness is enforced by
// the app-maintained `nameLower` column (matches the codebase convention —
// no citext, no expression indexes).
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  nameLower String   @unique @map("name_lower")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tags")
}

model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  assetLayoutId  String    @map("asset_layout_id") @db.Uuid
  name           String
  externalId     String?   @map("external_id")
  externalSource String?   @map("external_source")
  archivedAt     DateTime? @map("archived_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // `onDelete: Restrict` — a layout with any asset cannot be hard-deleted,
  // only archived. This matches the builder's "archive" affordance.
  assetLayout            AssetLayout             @relation(fields: [assetLayoutId], references: [id], onDelete: Restrict)
  fieldValues            AssetFieldValue[]
  passwords              Password[]
  starredBy              StarredAsset[]
  // Phase 11.2: 0..N links to external records. An asset can be
  // simultaneously linked to several integrations (e.g. an Action1
  // endpoint and a UniFi client representing the same physical
  // machine). Each `IntegrationSyncRecord` row scopes its binding by
  // `(integrationCompanyMappingId, resourceId)` and the resolver
  // refuses to claim an asset that already carries a sync record
  // from the same `(mapping, resource)` pair.
  integrationSyncRecords IntegrationSyncRecord[]

  @@index([companyId, assetLayoutId, archivedAt])
  @@index([companyId, name])
  @@index([companyId, updatedAt])
  // Phase 11: unique-by-source so the resolver can claim a row by
  // (companyId, externalSource, externalId) without scanning. NULLs
  // are allowed (manual assets) — handled by the partial unique index
  // in the migration.
  @@index([companyId, externalSource, externalId])
  @@map("assets")
}

// `companyId` is denormalized from Asset so the tenant middleware (see
// apps/api/src/prisma/tenant-scoped-models.ts) can enforce scope on
// bulk writes and on upserts keyed by the (assetId, assetFieldId)
// composite — neither of which can carry a relational filter. The
// column is kept in sync by the service layer (always set from the
// parent asset on create) and enforced by the FK below; since an
// asset's company never changes, it can be treated as immutable.
model AssetFieldValue {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  assetFieldId String   @map("asset_field_id") @db.Uuid
  value        Json
  updatedAt    DateTime @updatedAt @map("updated_at")

  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetField AssetField @relation(fields: [assetFieldId], references: [id], onDelete: Cascade)

  @@unique([assetId, assetFieldId])
  @@index([assetFieldId])
  @@index([companyId, assetFieldId])
  @@map("asset_field_values")
}

// Phase 4: nested folder tree scoped per company. There is no "global"
// folder — an operator who wants a workspace for MSP-internal docs
// creates a regular Company tenant and its folders live under that
// company's id (see DECISIONS.md D-010).
model Folder {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  name       String
  slug       String
  icon       String?
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  parent   Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Folder[]  @relation("FolderTree")
  articles Article[]

  // Active-slug uniqueness per parent enforced by a partial unique index
  // (company_id, COALESCE(parent_id, '00000000-...'), slug) WHERE archived_at IS NULL.
  @@index([companyId, parentId, position])
  @@map("folders")
}

// Phase 4: article content. All articles carry a required companyId — no
// nullable escape hatch. "Internal" docs are just articles inside a
// company tenant (see DECISIONS.md D-010).
model Article {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  folderId         String?   @map("folder_id") @db.Uuid
  title            String
  slug             String
  editorMode       String    @default("tiptap") @map("editor_mode")
  /// Tiptap/ProseMirror JSON; null when `editorMode` is `markdown`.
  content          Json?
  /// Raw Markdown; null when `editorMode` is `tiptap`.
  markdownSource   String?   @map("markdown_source")
  contentPlaintext String    @map("content_plaintext")
  excerpt          String?
  visibleToClients Boolean   @default(true) @map("visible_to_clients")
  /// Monotonic optimistic-concurrency token. Incremented by the app on
  /// every content-affecting write INCLUDING autosave drafts (which is
  /// why ArticleVersion.version — reused when a draft is promoted —
  /// cannot serve). The AI chat apply path guards on it in the WHERE
  /// clause of the update.
  revision         Int       @default(1)
  archivedAt       DateTime? @map("archived_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  folder    Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  starredBy StarredArticle[]
  versions  ArticleVersion[]
  integrationSyncRecords IntegrationSyncRecord[]

  // Active-slug uniqueness per company enforced by a partial unique index
  // (company_id, slug) WHERE archived_at IS NULL.
  @@index([companyId, folderId])
  @@index([companyId, updatedAt])
  @@map("articles")
}

// Article history. Two kinds of rows:
//   - `isDraft = false` (published) — created on every explicit Save and
//     on `create()`. Monotonic per article (`@@unique([articleId,
//     version])`).
//   - `isDraft = true` (in-progress autosave) — at most one per article,
//     enforced by a partial unique index in migration. Coalesces across
//     successive autosaves so a typing session yields one row, not one
//     per 4 s tick. Cancel deletes the draft; explicit Save flips it to
//     published.
//
// `companyId` is denormalised so the Prisma tenant middleware can scope
// queries without joining (see TENANT_SCOPED_MODELS).
// `ON DELETE CASCADE` on the Article relation guarantees `purge()`
// removes every history row alongside the article — no orphans.
model ArticleVersion {
  id               String   @id @default(uuid()) @db.Uuid
  articleId        String   @map("article_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  version          Int
  isDraft          Boolean  @default(false) @map("is_draft")
  title            String
  slug             String
  folderId         String?  @map("folder_id") @db.Uuid
  visibleToClients Boolean  @map("visible_to_clients")
  editorMode       String   @map("editor_mode")
  /// Tiptap/ProseMirror JSON snapshot; null when `editorMode` is `markdown`.
  content          Json?
  /// Raw Markdown snapshot; null when `editorMode` is `tiptap`.
  markdownSource   String?  @map("markdown_source")
  contentPlaintext String   @map("content_plaintext")
  excerpt          String?
  changedFields    String[] @default([]) @map("changed_fields")
  changedBy        String   @map("changed_by") @db.Uuid
  changeReason     String?  @map("change_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId, isDraft, createdAt])
  @@index([companyId, createdAt])
  @@map("article_versions")
}

// Phase 4: every Upload is hard-scoped to a company (D-012). Storage keys
// always start with `company/<companyId>/…`. `attachedToType` /
// `attachedToId` are denormalised so the photos gallery can filter
// without scanning JSON.
model Upload {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  uploaderId     String?   @map("uploader_id") @db.Uuid
  filename       String
  mimeType       String    @map("mime_type")
  sizeBytes      Int       @map("size_bytes")
  storageKey     String    @unique @map("storage_key")
  sha256         String
  isImage        Boolean   @default(false) @map("is_image")
  width          Int?
  height         Int?
  thumbnailKey   String?   @map("thumbnail_key")
  attachedToType String?   @map("attached_to_type")
  attachedToId   String?   @map("attached_to_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Phase 9a back-reference. Populated only when an operator sets this
  // upload as a company logo; otherwise null.
  companyLogo Company? @relation("CompanyLogo")

  @@index([companyId, isImage, createdAt])
  @@index([attachedToType, attachedToId])
  @@index([companyId, deletedAt])
  @@map("uploads")
}

// Phase 3: polymorphic link table. Scaffolded + auto-populated from
// ASSET_REFERENCE field writes only. No Relation API/UI ships yet —
// that lands in Phase 5.
model Relation {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  sourceType   String   @map("source_type")
  sourceId     String   @map("source_id") @db.Uuid
  targetType   String   @map("target_type")
  targetId     String   @map("target_id") @db.Uuid
  relationType String   @map("relation_type")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  integrationSyncRecords IntegrationSyncRecord[]

  @@unique([sourceType, sourceId, targetType, targetId, relationType])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, targetType, targetId])
  @@map("relations")
}

// Phase 6: denormalised full-text search index across Asset, Article,
// and Upload rows. One table rather than generated columns on each
// source model because asset bodies are assembled from many
// AssetFieldValue rows at the API layer (see SearchIndexService), and
// because a single table simplifies ranking/querying across kinds.
//
// `body_public_tsv` and `body_internal_tsv` are `GENERATED ALWAYS AS
// (setweight(to_tsvector('english', coalesce(title, '')), 'A') ||
//  setweight(to_tsvector('english', coalesce(body_*, '')), 'B')) STORED`.
// Prisma models them as `Unsupported("tsvector")` because it has no
// first-class generated-column support; raw SQL owns the definition
// (see packages/db/prisma/migrations/0009_phase6_search_index).
//
// Article + Upload rows are maintained by DB triggers (their plaintext
// representation already lives in a column); Asset rows are maintained
// by the API's SearchIndexService because per-field visibility and the
// FieldTypeStrategy.toPlaintext logic live in TypeScript.
model SearchIndex {
  entityType       String    @map("entity_type")
  entityId         String    @map("entity_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  title            String
  bodyPublic       String    @map("body_public")
  bodyInternal     String    @map("body_internal")
  visibleToClients Boolean   @default(true) @map("visible_to_clients")
  // Copy of Password.restrictedToUserIds ('{}' = unrestricted; always
  // '{}' for non-password rows). Maintained by the password triggers.
  restrictedToUserIds String[] @default([]) @map("restricted_to_user_ids") @db.Uuid
  layoutId         String?   @map("layout_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at")
  updatedAt        DateTime  @map("updated_at")

  bodyPublicTsv   Unsupported("tsvector") @map("body_public_tsv")
  bodyInternalTsv Unsupported("tsvector") @map("body_internal_tsv")

  @@id([entityType, entityId])
  @@index([companyId, updatedAt(sort: Desc)])
  @@index([companyId, entityType, archivedAt])
  @@map("search_index")
}

// Phase 5: instance-wide branding + tenant terminology. Singleton row
// (id = 'singleton') seeded in the migration so callers never have to
// create it. Edited only via SUPER_ADMIN through the /admin/settings
// page; see DECISIONS.md D-014 (branding-is-a-setting-not-a-build-flag).
//
// `workspace*` drives the sidebar workspace chip. `tenantTerm*` is the
// noun used everywhere the UI would otherwise say "Company/Companies"
// — Hudu-style configurable (Client, Department, Tenant, Site, etc.).
// Stored as free-form strings so an operator can type a custom term;
// the settings form offers a preset dropdown for the common cases.
model SystemSetting {
  id                        String   @id @default("singleton")
  workspaceName             String   @default("My Company") @map("workspace_name")
  workspaceSubtitle         String   @default("workspace") @map("workspace_subtitle")
  tenantTermSingular        String   @default("Company") @map("tenant_term_singular")
  tenantTermPlural          String   @default("Companies") @map("tenant_term_plural")
  tenantTermPossessive      String?  @map("tenant_term_possessive")
  // Phase 10: workspace-wide defaults for the client-side password
  // generator. Shape validated by passwordGeneratorDefaultsSchema —
  // NULL falls back to DEFAULT_PASSWORD_GENERATOR_DEFAULTS on read.
  passwordGeneratorDefaults Json?    @map("password_generator_defaults")
  // Article editor: when true, the web editor debounces unsaved changes
  // and PATCHes with `draft: true` every ~4 s. Default off to avoid
  // surprise persistence; toggled from /admin/settings (security.mdc:
  // never trust the client's claim about this — the API treats
  // `draft: true` identically regardless of this setting).
  articleAutosaveEnabled    Boolean  @default(false) @map("article_autosave_enabled")
  // Default body editor for newly-created articles. Persisted as the
  // free-form string the discriminator schema accepts (`tiptap` |
  // `markdown`); a CHECK constraint in migration 0047 prevents a stray
  // value from being saved. Existing articles ignore this and keep
  // their own `editor_mode`.
  articleDefaultEditorMode  String   @default("tiptap") @map("article_default_editor_mode")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  updatedBy                 String?  @map("updated_by") @db.Uuid

  @@map("system_settings")
}

// Global outbound email configuration. Passwords are encrypted with the
// SMTP-specific AES-GCM envelope and are never returned by the API.
model EmailSetting {
  id                 String           @id @default("singleton")
  enabled            Boolean          @default(false)
  host               String?
  port               Int?
  secureMode         SmtpSecurityMode @default(STARTTLS) @map("secure_mode")
  username           String?
  passwordCiphertext String?          @map("password_ciphertext")
  fromName           String?          @map("from_name")
  fromEmail          String?          @map("from_email")
  replyTo            String?          @map("reply_to")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  updatedBy          String?          @map("updated_by") @db.Uuid

  @@map("email_settings")
}

// Global OpenAI-compatible LLM endpoint configuration (Ollama, LMStudio,
// vLLM, OpenAI itself, etc.). Foundation only — actual model calls land
// in a follow-up phase. `apiKeyCiphertext` is encrypted with the existing
// `IntegrationSecretEncryptionService` (AES-GCM via `INTEGRATION_SECRET_KEY`)
// since an LLM endpoint is conceptually one more integration; rotation
// piggybacks on the integrations key.
model AiSetting {
  id               String   @id @default("singleton")
  enabled          Boolean  @default(false)
  baseUrl          String?  @map("base_url")
  apiKeyCiphertext String?  @map("api_key_ciphertext")
  defaultModel     String?  @map("default_model")
  // Output-token ceiling for chat completions / reserved reply budget.
  // Null → conservative server default.
  maxOutputTokens     Int?  @map("max_output_tokens")
  // Total model context window, used to size the prompt budget. Null →
  // conservative server default.
  contextWindowTokens Int?  @map("context_window_tokens")
  // Opt-in for AI endpoints on private/LAN addresses (local Ollama,
  // LM Studio). When true, AI egress allows curated private ranges only —
  // cloud-metadata and link-local stay blocked (WS-017).
  allowPrivateNetwork Boolean @default(false) @map("allow_private_network")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@map("ai_settings")
}

// Phase 8: tenant-scoped "watch this domain" record. One row per
// hostname the MSP wants monitored. Check toggles + threshold are
// operator-editable; `visibleToClients` controls whether CLIENT_*
// roles can see the row on the portal (default false — MSP-internal).
//
// The denormalised expiry + latestStatus columns let the list view
// render without joining DomainCheck; the processor updates them
// inside the same transaction that writes a new DomainCheck.
//
// Active uniqueness on (company_id, hostname) is enforced by a partial
// unique index in raw SQL — see migration 0011_phase8_domain_monitor —
// so an archived row doesn't block re-adding a hostname, mirroring the
// article/folder pattern.
model MonitoredDomain {
  id                 String       @id @default(uuid()) @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  hostname           String
  checkWhois         Boolean      @default(true) @map("check_whois")
  checkDns           Boolean      @default(true) @map("check_dns")
  checkTls           Boolean      @default(true) @map("check_tls")
  alertThresholdDays Int          @default(30) @map("alert_threshold_days")
  // D-020: per-domain client visibility. Default false → MSP-internal.
  visibleToClients   Boolean      @default(false) @map("visible_to_clients")
  // Denormalised latest-run summary, updated by DomainChecksProcessor.
  lastCheckedAt      DateTime?    @map("last_checked_at")
  whoisExpiresAt     DateTime?    @map("whois_expires_at")
  tlsExpiresAt       DateTime?    @map("tls_expires_at")
  latestStatus       DomainStatus @default(UNKNOWN) @map("latest_status")
  // HTTP availability sub-check (alerts feature). When enabled the worker
  // performs a HEAD/GET reachability probe and persists the latest HTTP
  // status code + the timestamp the host has been continuously down
  // since. `httpDownSince` is NULL whenever the host is reachable and is
  // the read surface the alerts runner uses to fire `WEBSITE_DOWN`.
  httpCheckEnabled   Boolean      @default(true) @map("http_check_enabled")
  latestHttpStatus   Int?         @map("latest_http_status")
  httpDownSince      DateTime?    @map("http_down_since")
  // v2 — latest hygiene score (percentage 0-100). NULL until the first
  // v2 check runs. Denormalised so list/alert views don't have to join
  // the history table.
  latestScore        Int?         @map("latest_score")
  // v2 — DKIM selector override. Comma-separated list of selectors the
  // engine probes in addition to its MX-keyed defaults. NULL = use
  // defaults only.
  dkimSelectorOverride String?    @map("dkim_selector_override")
  archivedAt         DateTime?    @map("archived_at")
  createdBy          String?      @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  checks DomainCheck[]

  @@index([companyId, archivedAt])
  @@index([companyId, latestStatus])
  @@map("monitored_domains")
}

// Phase 8: append-only history of every check run. Kept forever — the
// UI only renders the last 30 per domain but audit / debugging wants
// the full trail. `details` holds the structured payload (see
// `packages/shared/src/schemas/domain.ts#domainCheckDetailsSchema`).
model DomainCheck {
  id                String       @id @default(uuid()) @db.Uuid
  monitoredDomainId String       @map("monitored_domain_id") @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  checkedAt         DateTime     @default(now()) @map("checked_at")
  whoisStatus       CheckResult? @map("whois_status")
  dnsStatus         CheckResult? @map("dns_status")
  tlsStatus         CheckResult? @map("tls_status")
  whoisExpiresAt    DateTime?    @map("whois_expires_at")
  tlsExpiresAt      DateTime?    @map("tls_expires_at")
  details           Json
  error             String?
  // v2 — denormalised percent score (0-100). NULL for legacy rows
  // written before the scoring rubric existed. We index by it so the
  // admin alerts panel can pull "< 35%" rows without scanning all
  // history.
  score             Int?
  // v2 — rubric schema version. 1 = legacy (no score), 2 = current
  // rubric. Each row keeps the version it was scored under so a
  // future rubric bump never retro-grades old rows.
  schemaVersion     Int          @default(1) @map("schema_version")

  domain MonitoredDomain @relation(fields: [monitoredDomainId], references: [id], onDelete: Cascade)

  @@index([monitoredDomainId, checkedAt(sort: Desc)])
  @@index([companyId, checkedAt(sort: Desc)])
  @@map("domain_checks")
}

// Phase 10: password vault. Company-scoped credentials with optional
// folder grouping and an optional `assetId` back-link for embedded
// credentials (archiving the parent asset cascades a soft-archive here
// — see AssetsService.archive). Every secret column (password, TOTP
// secret, notes) is AES-256-GCM encrypted at rest via the API's
// SecretEncryptionService; the ciphertext blob embeds a short `kid`
// so keys can be rotated via PASSWORD_PREVIOUS_KEYS lazily.
//
// List endpoints strip `passwordCiphertext`, `totpSecretCiphertext`
// and `notesCiphertext`. Detail GETs decrypt notes inline (they are
// authorized metadata). Password + TOTP secret are only returned via
// the explicit, audited, rate-limited POST /passwords/:id/reveal
// endpoint.
model Password {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  folderId             String?   @map("folder_id") @db.Uuid
  assetId              String?   @map("asset_id") @db.Uuid
  name                 String
  username             String?
  url                  String?
  notesCiphertext      String?   @map("notes_ciphertext")
  passwordCiphertext   String    @map("password_ciphertext")
  totpSecretCiphertext String?   @map("totp_secret_ciphertext")
  totpAlgorithm        TotpAlgo  @default(SHA1) @map("totp_algorithm")
  totpDigits           Int       @default(6) @map("totp_digits")
  totpPeriod           Int       @default(30) @map("totp_period")
  passwordStrength     Int?      @map("password_strength")
  pwnedCount           Int?      @map("pwned_count")
  pwnedCheckedAt       DateTime? @map("pwned_checked_at")
  lastRotatedAt        DateTime? @map("last_rotated_at")
  rotationReminderDays Int?      @map("rotation_reminder_days")
  expiresAt            DateTime? @map("expires_at")
  color                String?
  tags                 String[]  @default([])
  visibleToClients     Boolean   @default(false) @map("visible_to_clients")
  requireReasonToView  Boolean   @default(false) @map("require_reason_to_view")
  restrictedToUserIds  String[]  @default([]) @map("restricted_to_user_ids") @db.Uuid
  createdBy            String    @map("created_by") @db.Uuid
  updatedBy            String    @map("updated_by") @db.Uuid
  archivedAt           DateTime? @map("archived_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folder    PasswordFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  asset     Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  versions  PasswordVersion[]
  starredBy StarredPassword[]

  @@index([companyId, archivedAt])
  @@index([companyId, folderId])
  @@index([companyId, assetId])
  @@index([assetId])
  @@map("passwords")
}

// Phase 10: immutable, append-only history of every credential-field
// change on a Password. `companyId` is denormalised (same pattern as
// AssetFieldValue) so the tenant-middleware can enforce scope on
// versions without a relational filter. Tracked fields: name,
// username, url, password ciphertext, notes ciphertext, TOTP block.
// Lifecycle metadata (archivedAt, visibleToClients, tags, folderId,
// colour, restrictedToUserIds, reminder days, expiry) is NOT
// versioned — it flows through AuditLog only.
model PasswordVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  passwordId           String   @map("password_id") @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  version              Int
  name                 String
  username             String?
  url                  String?
  notesCiphertext      String?  @map("notes_ciphertext")
  passwordCiphertext   String   @map("password_ciphertext")
  totpSecretCiphertext String?  @map("totp_secret_ciphertext")
  totpAlgorithm        TotpAlgo @default(SHA1) @map("totp_algorithm")
  totpDigits           Int      @default(6) @map("totp_digits")
  totpPeriod           Int      @default(30) @map("totp_period")
  changedFields        String[] @default([]) @map("changed_fields")
  changedBy            String   @map("changed_by") @db.Uuid
  changeReason         String?  @map("change_reason")
  createdAt            DateTime @default(now()) @map("created_at")

  password Password @relation(fields: [passwordId], references: [id], onDelete: Cascade)

  @@unique([passwordId, version])
  @@index([passwordId, createdAt])
  @@index([companyId, createdAt])
  @@map("password_versions")
}

// Phase 10: per-company folder tree for Passwords. Separate from the
// Article `Folder` model — different permission surface and keeps the
// archive-cascade logic independent from docs.
model PasswordFolder {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  name       String
  icon       String?
  color      String?
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    PasswordFolder?  @relation("PasswordFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  PasswordFolder[] @relation("PasswordFolderTree")
  passwords Password[]

  @@index([companyId, archivedAt])
  @@index([companyId, parentId, position])
  @@map("password_folders")
}

// Phase 11 — universal integration framework. Top-level `Integration`
// rows are GLOBAL (no companyId): one row per configured connection
// to an external system (e.g. one Action1 tenant). Sync fans out into
// many Weavestream companies via `IntegrationCompanyMapping`. Only
// SUPER_ADMIN may create / edit / delete an Integration.
//
// `driver` keys into the in-memory `IntegrationDriverRegistry`
// (e.g. "action1"). `config` holds non-sensitive driver-specific
// parameters (base URLs, default page sizes…) — every secret lives
// in the sibling `IntegrationSecret` table, AES-256-GCM encrypted
// under `INTEGRATION_SECRET_KEY`. The split exists so a row dump
// (or a future API export) can carry config without ever exposing
// credentials.
enum IntegrationStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum IntegrationTargetKind {
  asset
  subnet
  ip_reservation
  article
  relation
}

enum IntegrationSyncState {
  active
  stale
  blocked
}

enum IntegrationSyncMode {
  incremental
  full
}

enum ReconstructionGapKind {
  secret_blocked
  missing_dependency
  validation
  unsupported
  ambiguous
  synchronization_error
}

model Integration {
  id            String            @id @default(uuid()) @db.Uuid
  driver        String
  name          String
  status        IntegrationStatus @default(PAUSED)
  /// Free-form JSON validated by the driver's `configSchema`. Never
  /// contains secrets — those live in `IntegrationSecret`.
  config        Json              @default("{}")
  /// BullMQ cron pattern (5-field). NULL disables scheduled syncs;
  /// manual `Run sync` from the admin UI still works.
  syncCron      String?           @map("sync_cron")
  lastRunAt     DateTime?         @map("last_run_at")
  lastRunStatus String?           @map("last_run_status")
  createdBy     String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  secret            IntegrationSecret?
  companyMappings   IntegrationCompanyMapping[]
  resources         IntegrationResource[]
  syncRuns          IntegrationSyncRun[]
  cloudflareIpLists CloudflareIpList[]

  @@unique([driver, name])
  @@index([driver])
  @@map("integrations")
}

/// Phase 11.1 — per-resource configuration owned by a single Integration.
///
/// A driver advertises one or more resources it can sync (UniFi:
/// devices + clients, Action1: records). Each `(integration, resourceKey)`
/// pair owns its own target asset layout, match keys, field mappings,
/// and sync-record namespace, while `IntegrationCompanyMapping` rows
/// (host ↔ company) remain shared across every resource of the
/// integration.
///
/// `resourceKey` is validated by the driver descriptor's `resources`
/// array; the API rejects writes for unknown keys.
model IntegrationResource {
  id               String   @id @default(uuid()) @db.Uuid
  integrationId    String   @map("integration_id") @db.Uuid
  /// Driver-validated short key (e.g. 'devices', 'clients', 'records').
  resourceKey      String   @map("resource_key")
  enabled          Boolean  @default(true)
  targetKind            IntegrationTargetKind @default(asset) @map("target_kind")
  targetConfig          Json                  @default("{}") @map("target_config")
  dependsOnResourceKeys String[]              @default([]) @map("depends_on_resource_keys")
  /// Target layout for this resource. NULL while the operator is still
  /// configuring it — runs short-circuit with a "missing layout" error
  /// in that state.
  assetLayoutId    String?  @map("asset_layout_id") @db.Uuid
  /// Match-key AssetField ids (must belong to `assetLayoutId`). Empty
  /// array means "always create on miss".
  matchKeyFieldIds String[] @default([]) @map("match_key_field_ids") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  integration   Integration               @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  assetLayout   AssetLayout?              @relation(fields: [assetLayoutId], references: [id], onDelete: Restrict)
  fieldMappings IntegrationFieldMapping[]
  syncRecords   IntegrationSyncRecord[]
  syncCheckpoints         IntegrationSyncCheckpoint[]
  reconstructionSummaries IntegrationReconstructionSummary[]
  reconstructionGaps      IntegrationReconstructionGap[]

  @@unique([integrationId, resourceKey])
  @@unique([id, targetKind])
  @@index([assetLayoutId])
  @@map("integration_resources")
}

// Phase 11 — encrypted secret bundle for a single Integration. Stored
// as an opaque base64 ciphertext produced by the integration crypto
// service. Decryption requires the active `INTEGRATION_SECRET_KEY`;
// rotation follows the same `kid`-tagged scheme as the password vault.
model IntegrationSecret {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @unique @map("integration_id") @db.Uuid
  /// Base64 AES-256-GCM blob with embedded `kid`. Decrypts to a JSON
  /// string the driver parses against its `secretSchema`.
  ciphertext    String
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_secrets")
}

// Phase 11 — tenant-scoped row that ties a single external organisation
// (Action1 `org_id`) to a Weavestream company. Layout + match-key
// fields + field mappings are all GLOBAL on the parent `Integration`
// — this row only carries the per-tenant fan-out info (which company,
// which upstream org, optional driver filter, enabled flag).
//
// Listed in `tenant-scoped-models.ts` so the tenant middleware blocks
// out-of-scope reads/writes for non-SUPER_ADMIN callers.
model IntegrationCompanyMapping {
  id              String   @id @default(uuid()) @db.Uuid
  integrationId   String   @map("integration_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  /// External (driver-side) organisation id this mapping pulls from.
  externalOrgId   String   @map("external_org_id")
  /// Snapshot of the external organisation's display name. Refreshed
  /// each time `listSourceOrgs` is reconciled in the admin UI.
  externalOrgName String?  @map("external_org_name")
  enabled         Boolean  @default(true)
  /// Optional driver-specific filter blob (e.g. site/group restrictions).
  /// Validated by the driver's `mappingFilterSchema` if defined.
  filter          Json     @default("{}")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  integration Integration                       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  company     Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  syncRecords IntegrationSyncRecord[]
  runResults  IntegrationSyncRunCompanyResult[]
  syncCheckpoints         IntegrationSyncCheckpoint[]
  reconstructionSummaries IntegrationReconstructionSummary[]
  reconstructionGaps      IntegrationReconstructionGap[]

  @@unique([integrationId, externalOrgId])
  @@index([companyId, integrationId])
  @@map("integration_company_mappings")
}

// Phase 11 — describes how a single source field is projected onto a
// Weavestream `AssetField`. GLOBAL: one row per (integration, sourceField),
// shared across every per-company mapping. The `transform` blob is
// reserved for the driver's transform DSL (e.g. `lowercase`,
// `coerce_date`). `syncDirection` controls how the worker resolves
// conflicts on update:
//   - source_wins      : driver value always replaces the stored value
//   - preserve_manual  : skip the field if the stored value differs
//                        from the last-synced checksum (operator edited)
//   - manual_only      : never touch the field; field exists for display
//                        only and the worker treats it as not mapped.
enum IntegrationSyncDirection {
  source_wins
  preserve_manual
  manual_only
}

model IntegrationFieldMapping {
  id            String                   @id @default(uuid()) @db.Uuid
  /// Phase 11.1 — field mappings live on a per-resource container, so
  /// devices vs clients (under the same UniFi integration) can map onto
  /// different layouts with different source-field projections.
  resourceId    String                   @map("resource_id") @db.Uuid
  sourceField   String                   @map("source_field")
  targetKind    IntegrationTargetKind    @default(asset) @map("target_kind")
  targetFieldId String?                  @map("target_field_id") @db.Uuid
  targetPath    String?                  @map("target_path") @db.VarChar(4096)
  syncDirection IntegrationSyncDirection @default(source_wins) @map("sync_direction")
  /// Optional transform descriptor; null means identity.
  transform     Json?
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  resource    IntegrationResource @relation(fields: [resourceId, targetKind], references: [id, targetKind], onDelete: Cascade)
  targetField AssetField?         @relation(fields: [targetFieldId], references: [id], onDelete: Cascade)

  @@unique([resourceId, sourceField])
  @@index([targetFieldId])
  @@index([resourceId, targetKind])
  @@map("integration_field_mappings")
}

// Phase 11 — top-level "this Integration ran a sync" row. `kind` is
// either `manual` (operator pressed the button) or `scheduled`
// (cron fired). `dryRun=true` means the worker computed every
// resolution but wrote nothing — safe to use to validate mappings.
enum IntegrationRunKind {
  manual
  scheduled
}

enum IntegrationRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

model IntegrationSyncRun {
  id            String               @id @default(uuid()) @db.Uuid
  integrationId String               @map("integration_id") @db.Uuid
  kind          IntegrationRunKind
  status        IntegrationRunStatus @default(queued)
  dryRun        Boolean              @default(false) @map("dry_run")
  triggeredBy   String?              @map("triggered_by") @db.Uuid
  startedAt     DateTime?            @map("started_at")
  finishedAt    DateTime?            @map("finished_at")
  /// Aggregate counters across every per-mapping child run. Filled in
  /// by the orchestrator once children settle.
  totals        Json?
  /// Optional terminal error — populated when status=failed.
  error         String?
  createdAt     DateTime             @default(now()) @map("created_at")

  integration    Integration                       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  companyResults IntegrationSyncRunCompanyResult[]
  syncRecords    IntegrationSyncRecord[]

  @@index([integrationId, createdAt])
  @@map("integration_sync_runs")
}

// Phase 11 — per-mapping result row written by the per-mapping
// processor. Tenant-scoped via `companyId` so operators can read
// their tenant's runs without exposing other companies' counters.
model IntegrationSyncRunCompanyResult {
  id                          String               @id @default(uuid()) @db.Uuid
  syncRunId                   String               @map("sync_run_id") @db.Uuid
  integrationCompanyMappingId String               @map("integration_company_mapping_id") @db.Uuid
  companyId                   String               @map("company_id") @db.Uuid
  status                      IntegrationRunStatus @default(queued)
  startedAt                   DateTime?            @map("started_at")
  finishedAt                  DateTime?            @map("finished_at")
  /// `{ created: n, updated: n, claimed: n, archived: n, skippedAmbiguous: n,
  ///    skippedManual: n, errors: n, fetched: n }`.
  totals                      Json?
  /// Up to N structured conflicts (ambiguous match, validation error)
  /// for the operator to triage from the run viewer. Capped to keep
  /// the row tiny.
  conflicts                   Json?
  error                       String?
  createdAt                   DateTime             @default(now()) @map("created_at")

  syncRun        IntegrationSyncRun        @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  companyMapping IntegrationCompanyMapping @relation(fields: [integrationCompanyMappingId], references: [id], onDelete: Cascade)

  @@unique([syncRunId, integrationCompanyMappingId])
  @@index([companyId, createdAt])
  @@map("integration_sync_run_company_results")
}

// Phase 11 — durable link between an external record and a
// Weavestream `Asset`. One row per (companyMapping, externalId).
// `lastSyncedFieldChecksums` is a `{ assetFieldId: sha256 }` map
// recorded on every successful field write; the next sync uses it
// to detect manual edits when `syncDirection=preserve_manual`.
//
// `companyId` is denormalised so the tenant middleware can enforce
// scope without a relational filter (mirrors AssetFieldValue).
model IntegrationSyncRecord {
  id                          String   @id @default(uuid()) @db.Uuid
  integrationCompanyMappingId String   @map("integration_company_mapping_id") @db.Uuid
  /// Phase 11.1 — scopes the binding to a single resource. A device
  /// with the same external id as a client (rare, but possible across
  /// resource namespaces) gets two distinct sync-records pointing at
  /// two distinct assets in two distinct layouts.
  resourceId                  String   @map("resource_id") @db.Uuid
  syncRunId                   String?  @map("sync_run_id") @db.Uuid
  companyId                   String   @map("company_id") @db.Uuid
  targetKind                  IntegrationTargetKind @default(asset) @map("target_kind")
  assetId                     String?               @map("asset_id") @db.Uuid
  subnetId                    String?               @map("subnet_id") @db.Uuid
  ipReservationId             String?               @map("ip_reservation_id") @db.Uuid
  articleId                   String?               @map("article_id") @db.Uuid
  relationId                  String?               @map("relation_id") @db.Uuid
  externalId                  String   @map("external_id")
  lastSyncedAt                DateTime @map("last_synced_at")
  state                       IntegrationSyncState  @default(active)
  lastSeenAt                  DateTime              @map("last_seen_at")
  staleSince                  DateTime?             @map("stale_since")
  sourceUpdatedAt             DateTime?             @map("source_updated_at")
  provenance                  Json                  @default("{}")
  /// SHA-256 hex of the canonicalised JSON body returned by the driver
  /// during the most recent successful upsert. Identical checksum on
  /// the next run = nothing to do.
  checksum                    String
  /// Per-field SHA-256 checksums — keyed by `AssetField.id`. Drives
  /// `preserve_manual` conflict detection.
  lastSyncedFieldChecksums    Json     @default("{}") @map("last_synced_field_checksums")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  companyMapping IntegrationCompanyMapping @relation(fields: [integrationCompanyMappingId], references: [id], onDelete: Cascade)
  resource           IntegrationResource            @relation(fields: [resourceId, targetKind], references: [id, targetKind], onDelete: Cascade)
  asset              Asset?                         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  subnet             Subnet?                        @relation(fields: [subnetId], references: [id], onDelete: Cascade)
  ipReservation      IpReservation?                 @relation(fields: [ipReservationId], references: [id], onDelete: Cascade)
  article            Article?                       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  relation           Relation?                      @relation(fields: [relationId], references: [id], onDelete: Cascade)
  syncRun        IntegrationSyncRun?       @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  reconstructionGaps IntegrationReconstructionGap[]

  @@unique([integrationCompanyMappingId, resourceId, externalId])
  @@index([assetId])
  @@index([subnetId])
  @@index([ipReservationId])
  @@index([articleId])
  @@index([relationId])
  @@index([companyId, integrationCompanyMappingId])
  @@index([resourceId, targetKind])
  @@map("integration_sync_records")
}

model IntegrationSyncCheckpoint {
  id                          String    @id @default(uuid()) @db.Uuid
  companyId                   String    @map("company_id") @db.Uuid
  integrationCompanyMappingId String    @map("integration_company_mapping_id") @db.Uuid
  resourceId                  String    @map("resource_id") @db.Uuid
  mode                        IntegrationSyncMode @default(incremental)
  cursor                      String?   @db.VarChar(4096)
  snapshotAt                  DateTime? @map("snapshot_at")
  highWaterAt                 DateTime? @map("high_water_at")
  lastCompletedAt             DateTime? @map("last_completed_at")
  lastFullCompletedAt         DateTime? @map("last_full_completed_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyMapping IntegrationCompanyMapping @relation(fields: [integrationCompanyMappingId], references: [id], onDelete: Cascade)
  resource       IntegrationResource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([integrationCompanyMappingId, resourceId, mode])
  @@index([companyId, integrationCompanyMappingId])
  @@index([resourceId, lastCompletedAt])
  @@index([resourceId, mode, lastCompletedAt])
  @@map("integration_sync_checkpoints")
}

model IntegrationReconstructionSummary {
  id                          String    @id @default(uuid()) @db.Uuid
  companyId                   String    @map("company_id") @db.Uuid
  integrationCompanyMappingId String    @map("integration_company_mapping_id") @db.Uuid
  resourceId                  String?   @map("resource_id") @db.Uuid
  summaryKey                  String    @default("all") @map("summary_key") @db.VarChar(128)
  counts                      Json      @default("{}")
  evaluatedAt                 DateTime  @map("evaluated_at")
  lastSuccessfulSyncAt        DateTime? @map("last_successful_sync_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyMapping IntegrationCompanyMapping @relation(fields: [integrationCompanyMappingId], references: [id], onDelete: Cascade)
  resource       IntegrationResource?      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([integrationCompanyMappingId, summaryKey])
  @@index([companyId, evaluatedAt])
  @@index([resourceId, evaluatedAt])
  @@map("integration_reconstruction_summaries")
}

model IntegrationReconstructionGap {
  id                          String                @id @default(uuid()) @db.Uuid
  companyId                   String                @map("company_id") @db.Uuid
  integrationCompanyMappingId String                @map("integration_company_mapping_id") @db.Uuid
  resourceId                  String                @map("resource_id") @db.Uuid
  syncRecordId                String?               @map("sync_record_id") @db.Uuid
  dedupeKey                   String                @map("dedupe_key") @db.VarChar(256)
  kind                        ReconstructionGapKind
  message                     String                @db.VarChar(512)
  details                     Json                  @default("{}")
  firstSeenAt                 DateTime              @map("first_seen_at")
  lastSeenAt                  DateTime              @map("last_seen_at")
  resolvedAt                  DateTime?             @map("resolved_at")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")

  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyMapping IntegrationCompanyMapping @relation(fields: [integrationCompanyMappingId], references: [id], onDelete: Cascade)
  resource       IntegrationResource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  syncRecord     IntegrationSyncRecord?    @relation(fields: [syncRecordId], references: [id], onDelete: SetNull)

  @@unique([integrationCompanyMappingId, resourceId, dedupeKey])
  @@index([companyId, resolvedAt, lastSeenAt])
  @@index([resourceId, resolvedAt, kind])
  @@index([syncRecordId])
  @@map("integration_reconstruction_gaps")
}

// Cloudflare Zero Trust Gateway Lists integration — a registered
// IP-typed Gateway list managed by Weavestream. The parent `Integration`
// row holds the API token (in IntegrationSecret) and the CF account id
// (in config). One CloudflareIpList row per registered Gateway list.
//
// Unlike the asset-import drivers, this is a SECURITY-kind integration:
// global, super-admin only, no `IntegrationCompanyMapping` rows. Entries
// are stored as a JSON array — Weavestream is the source of truth and
// PATCHes Cloudflare's view (append/remove diff) to bring it in line.
//
// `entries`: `[{ ip: string, description: string }, ...]`. Gateway items
// have no per-item id — Cloudflare addresses them by string value.
// `entriesVersion` is an optimistic-concurrency token bumped on every
// successful local mutation; the API returns 409 on mismatch.
enum CloudflareDriftStatus {
  in_sync
  drift_detected
  unknown
  error
}

model CloudflareIpList {
  id                String                @id @default(uuid()) @db.Uuid
  integrationId     String                @map("integration_id") @db.Uuid
  externalAccountId String                @map("external_account_id")
  externalListId    String                @map("external_list_id")
  name              String
  description       String?
  /// `[{ ip: string, description: string }, ...]`
  entries           Json                  @default("[]")
  /// Optimistic-concurrency token — bumped on every successful local mutation.
  entriesVersion    Int                   @default(1) @map("entries_version")
  driftStatus       CloudflareDriftStatus @default(unknown) @map("drift_status")
  /// `{ missingOnCf: [...], extraOnCf: [...], lastError?: string }`
  driftDetails      Json?                 @map("drift_details")
  lastDriftCheckAt  DateTime?             @map("last_drift_check_at")
  lastPushedAt      DateTime?             @map("last_pushed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalListId])
  @@index([integrationId])
  @@map("cloudflare_ip_lists")
}

// User-configurable email alerts. Five disjoint shapes (the `type`
// discriminator) all share the same envelope so the admin list can
// render them in a single table. Validation per type is enforced by
// `packages/shared/src/schemas/alert.ts` at the API boundary; the DB
// keeps every per-type knob nullable / array-default-empty so a row
// of any type fits without per-type tables.
//
// Two execution paths consume these rows:
//   1. The scheduled `alerts:scan` BullMQ job evaluates the three
//      time/state-based types (SINGLE_EXPIRATION, EXPIRATION_LIST,
//      WEBSITE_DOWN). The runner aggregates expiry / down-since
//      surfaces and enqueues `alerts:send` per match.
//   2. `AlertEmitterService` runs synchronously inside
//      `AuditLogService.log()` and matches RECORD_EVENT /
//      PASSWORD_EVENT configs against the audit entry. Cache-driven
//      so the request path pays no DB query when no configs match.
//
// `AlertTrigger` is the dedup ledger — one row per (config, key)
// where `key` uniquely identifies the underlying thing that fired
// (e.g. `single:asset-field:<fieldId>:<assetId>` or
// `audit:<auditLogId>:<configId>`). Both paths upsert with
// `skipDuplicates` so retries never double-send.
enum AlertType {
  SINGLE_EXPIRATION
  EXPIRATION_LIST
  WEBSITE_DOWN
  RECORD_EVENT
  PASSWORD_EVENT
}

model AlertConfig {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  type            AlertType
  enabled         Boolean   @default(true)
  // One or more recipient addresses. Persisted as a Postgres TEXT[] so
  // a single config can fan out to a team alias plus a person, etc.
  // Always non-empty (validated at the API boundary).
  recipientEmails String[]  @default([]) @map("recipient_emails")
  // Optional company scope. NULL = applies across every tenant.
  companyId       String?   @map("company_id") @db.Uuid

  // Expiration knobs (SINGLE_EXPIRATION + EXPIRATION_LIST).
  triggerDays      Int?     @map("trigger_days")
  stopAfterTrigger Boolean  @default(true) @map("stop_after_trigger")
  // Subset of: 'asset', 'domain_registrar', 'domain_tls', 'password', 'all'.
  expirationKinds  String[] @default([]) @map("expiration_kinds")

  // Record/password event knobs.
  // Subset of: 'asset', 'article', 'password', 'domain', 'all'.
  recordEntityTypes String[] @default([]) @map("record_entity_types")
  // Subset of: 'created', 'updated', 'deleted', 'all'.
  recordActions     String[] @default([]) @map("record_actions")

  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  triggers AlertTrigger[]

  @@index([type, enabled, archivedAt])
  @@index([archivedAt])
  @@map("alert_config")
}

model AlertTrigger {
  id            String   @id @default(uuid()) @db.Uuid
  alertConfigId String   @map("alert_config_id") @db.Uuid
  // Stable identifier for the underlying thing that fired. Format is
  // owned by the runner — see `AlertsRunnerService` and
  // `AlertEmitterService` for the conventions.
  key           String
  firedAt       DateTime @default(now()) @map("fired_at")

  alertConfig AlertConfig @relation(fields: [alertConfigId], references: [id], onDelete: Cascade)

  @@unique([alertConfigId, key])
  @@index([alertConfigId, firedAt])
  @@map("alert_trigger")
}

// Phase 5: Manual IP allow/deny rules. Enforced globally before any
// authentication attempt. Rules are evaluated in priority order (ascending);
// the first matching rule wins. If no rules match, access is allowed.
// Supports single IPs (192.168.1.1) or CIDR ranges (10.0.0.0/8).
enum IpRuleAction {
  ALLOW
  DENY
}

model IpRule {
  id        String       @id @default(uuid()) @db.Uuid
  // CIDR notation or single IP: "192.168.1.1" or "10.0.0.0/8"
  cidr      String
  action    IpRuleAction
  // Optional human-readable note explaining why this rule exists
  note      String?
  // Priority for evaluation order (lower = evaluated first)
  priority  Int          @default(0)
  // Disabled rules are ignored during evaluation but kept in DB
  enabled   Boolean      @default(true)
  createdBy String?      @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("ip_rules")
}

// IPAM — company-scoped IPv4 subnet registry. Operators define a CIDR
// block and the system passively discovers matching assets by querying
// `AssetFieldValue` rows whose `IP_ADDRESS` value falls within the
// range (via PostgreSQL `inet` containment). No active scanning.
model Subnet {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  cidr        String
  prefix      Int
  vlanId      Int?      @map("vlan_id")
  gateway     String?
  dhcpRangeStart String? @map("dhcp_range_start")
  dhcpRangeEnd   String? @map("dhcp_range_end")
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  reservations IpReservation[]
  integrationSyncRecords IntegrationSyncRecord[]

  @@index([companyId, archivedAt])
  @@map("subnets")
}

// IPAM — manual IP reservation within a subnet. Lets operators pin a
// label to an IP slot without needing a full asset record, filling gaps
// in the address-grid view.
model IpReservation {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  subnetId  String   @map("subnet_id") @db.Uuid
  ipAddress String   @map("ip_address")
  label     String
  notes     String?
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subnet Subnet @relation(fields: [subnetId], references: [id], onDelete: Cascade)
  integrationSyncRecords IntegrationSyncRecord[]

  @@unique([subnetId, ipAddress])
  @@index([companyId, subnetId])
  @@map("ip_reservations")
}

// Scheduled Postgres dump feature. One row per admin-configured
// schedule; the API-side `BackupQueueRegistrar` asserts one BullMQ
// repeatable per enabled row, and every fire produces a `BackupRun`.
// Dumps land on the host via a bind mount at
// `${DATA_DIR}/backup:/var/lib/weavestream/backup`, accompanied by a
// `*.manifest.json` sidecar. Operators are responsible for including
// both `${DATA_DIR}/backup` and `${DATA_DIR}/files` in their external
// backup routine — the runbook makes this explicit.
model BackupConfig {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  enabled         Boolean   @default(true)
  // Standard 5-field cron pattern (minute hour dom month dow). The
  // worker uses BullMQ's repeat.pattern, which is cron-parser compatible.
  cron            String
  // IANA timezone name (e.g. "Etc/UTC", "America/New_York"). Nullable
  // so the registrar can fall back to `Etc/UTC` when unset.
  timezone        String?
  // GFS retention: { daily: number, weekly: number, monthly: number }.
  // Defaults applied at the API boundary.
  retention       Json
  // Notification recipients. Empty array = notifications disabled.
  notifyEmails    String[]  @default([]) @map("notify_emails")
  notifyOnSuccess Boolean   @default(false) @map("notify_on_success")
  lastRunAt       DateTime? @map("last_run_at")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  runs BackupRun[]

  @@index([enabled])
  @@map("backup_config")
}

enum BackupRunKind {
  SCHEDULED
  MANUAL
}

enum BackupRunStatus {
  queued
  running
  success
  failed
}

// One row per backup attempt. `configId` is nullable so a future
// operator-driven ad-hoc run (no saved schedule) can still reuse the
// same table.
model BackupRun {
  id           String          @id @default(uuid()) @db.Uuid
  configId     String?         @map("config_id") @db.Uuid
  kind         BackupRunKind
  status       BackupRunStatus @default(queued)
  startedAt    DateTime?       @map("started_at")
  finishedAt   DateTime?       @map("finished_at")
  sizeBytes    BigInt?         @map("size_bytes")
  // Snapshot of the manifest.json emitted beside the dump — keeps
  // operator-facing diagnostics queryable without opening the file.
  manifest     Json?
  dumpPath     String?         @map("dump_path")
  manifestPath String?         @map("manifest_path")
  error        String?
  triggeredBy  String?         @map("triggered_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")

  config BackupConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([configId, startedAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("backup_run")
}

// Per-user AI chat conversations. Each conversation belongs to exactly
// one user (no company / tenant scoping in this phase) and cascades on
// user deletion. The `title` defaults to "New chat" and is filled in
// from the first user message on the first turn. `model` records which
// LLM model produced the assistant replies so future model swaps in
// `AiSetting.defaultModel` don't retroactively change history.
model ChatConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @default("New chat")
  model     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           ChatRole
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  /// Proposed agentic actions attached to this assistant turn. Shape:
  /// [{ id, name, arguments, status, result?, error?, errorCode? }]. Null
  /// on user messages and on assistant messages that did not propose an
  /// action.
  toolCalls      Json?    @map("tool_calls")
  /// Snapshot of the request scope that produced this turn (companyId,
  /// currentArticleId, attached article ids — METADATA ONLY, never
  /// bodies). Bound to the turn so apply/follow-up don't re-sample
  /// whatever page is open later. Descriptive only; never an
  /// authorization source. Null on legacy rows and turns with no scope.
  turnContext    Json?    @map("turn_context")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum ChatRole {
  USER
  ASSISTANT
}
