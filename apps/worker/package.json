{
  "name": "@weavestream/worker",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build && node scripts/check-worker-deps.mjs",
    "start": "node dist/main.js",
    "dev": "nest start --watch --shell --exec \"node --watch\"",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deps:check": "node scripts/check-worker-deps.mjs",
    "test": "jest --passWithNoTests && node scripts/check-worker-deps.mjs --self-test && node scripts/check-worker-deps.mjs --wiring"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@weavestream/api": "workspace:*",
    "@weavestream/shared": "workspace:*",
    "bullmq": "^5.76.2",
    "fontkit": "^2.0.4",
    "nestjs-pino": "^4.1.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  }
}
