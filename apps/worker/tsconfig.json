{
  "extends": "../../packages/config/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "types": ["node", "jest"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "paths": {
      "@weavestream/shared": ["../../packages/shared/dist/index.d.ts"],
      "@weavestream/shared/server": ["../../packages/shared/dist/server.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "../api/src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.spec.ts",
    "../api/src/main.ts",
    "../api/src/cli.ts",
    "../api/dist",
    "../api/node_modules"
  ]
}
