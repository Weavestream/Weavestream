{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The app tsconfig targets Next's bundler (ESNext/Bundler); jest
    // runs the compiled output on plain Node, so specs compile as CJS.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "incremental": false,
    "jsx": "react-jsx",
    "types": ["node", "jest", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
