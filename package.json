{
  "name": "weavestream",
  "version": "1.9.1",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @weavestream/api build && pnpm -r typecheck",
    "test": "pnpm --filter @weavestream/api build && pnpm -r test",
    "audit": "pnpm audit --prod --audit-level=high",
    "deadcode": "knip --workspace apps/web",
    "keygen": "node scripts/keygen.mjs",
    "prisma:generate": "pnpm --filter @weavestream/db prisma:generate",
    "prisma:migrate": "pnpm --filter @weavestream/db prisma:migrate",
    "prisma:deploy": "pnpm --filter @weavestream/db prisma:deploy"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  }
}
